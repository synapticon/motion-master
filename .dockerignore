# Exclude .git/ to avoid busting the COPY layer on every commit, but
# re-include .git/modules/ so the extern/vcpkg gitfile can resolve inside
# the container (extern/vcpkg/.git points to ../../.git/modules/extern/vcpkg).
.git/
!.git/modules/
build/

# Never let a repo-root cert.pem/key.pem enter the build context — the image bakes the cert by
# fetching it from the rolling tls-cert release (see Dockerfile). Excluding them also defuses the
# Docker footgun where `-v "$(pwd)/cert.pem:..."` with no local file auto-creates a directory here.
cert.pem
key.pem

# The image downloads the auto-tuning executable in the build stage (see Dockerfile). A copy left
# in the repository root by install-auto-tuning.sh must not enter the build context. The script
# keeps a file that is already there, so a local copy for another architecture would be baked in.
auto-tuning
