{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/extern/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/ports",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      }
    },
    {
      "name": "x64-linux-debug",
      "inherits": "base",
      "displayName": "Linux x64 Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "x64-linux-release",
      "inherits": "base",
      "displayName": "Linux x64 Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "x64-linux-tsan",
      "inherits": "base",
      "displayName": "Linux x64 ThreadSanitizer",
      "description": "Debug build under ThreadSanitizer. The only mechanical check on the locking rules in docs/LOCKING.md — the concurrency tests are written to be run here, where an unsynchronised read is a reported race rather than a crash that reproduces once a month. Pinned to clang: GCC refuses to compile ProcessDataRing's acquire fence under -fsanitize=thread at all ('atomic_thread_fence is not supported', -Werror=tsan), because its TSan cannot model a standalone fence. That warning is true of clang too — it just says so instead of failing — and it is precisely why the seqlock carries a suppression rather than being verified.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "x64-windows-debug",
      "inherits": "base",
      "displayName": "Windows x64 Debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "x64-windows-release",
      "inherits": "base",
      "displayName": "Windows x64 Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "arm64-osx-debug",
      "inherits": "base",
      "displayName": "macOS ARM64 Debug (Apple Silicon)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3"
      }
    },
    {
      "name": "arm64-osx-release",
      "inherits": "base",
      "displayName": "macOS ARM64 Release (Apple Silicon)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3"
      }
    },
    {
      "name": "arm64-linux-debug",
      "inherits": "base",
      "displayName": "Linux ARM64 Debug (native)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-linux"
      }
    },
    {
      "name": "arm64-linux-release",
      "inherits": "base",
      "displayName": "Linux ARM64 Release (native)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-linux"
      }
    },
    {
      "name": "arm64-linux-cross-debug",
      "inherits": "base",
      "displayName": "Linux ARM64 Debug (cross-compile from x64)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "arm64-linux-cross",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "arm64-linux-cross-release",
      "inherits": "base",
      "displayName": "Linux ARM64 Release (cross-compile from x64)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "arm64-linux-cross",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-linux-debug",
      "configurePreset": "x64-linux-debug"
    },
    {
      "name": "x64-linux-release",
      "configurePreset": "x64-linux-release"
    },
    {
      "name": "x64-linux-tsan",
      "configurePreset": "x64-linux-tsan"
    },
    {
      "name": "x64-windows-debug",
      "configurePreset": "x64-windows-debug"
    },
    {
      "name": "x64-windows-release",
      "configurePreset": "x64-windows-release"
    },
    {
      "name": "arm64-osx-debug",
      "configurePreset": "arm64-osx-debug"
    },
    {
      "name": "arm64-osx-release",
      "configurePreset": "arm64-osx-release"
    },
    {
      "name": "arm64-linux-debug",
      "configurePreset": "arm64-linux-debug"
    },
    {
      "name": "arm64-linux-release",
      "configurePreset": "arm64-linux-release"
