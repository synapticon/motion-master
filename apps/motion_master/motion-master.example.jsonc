// motion-master.example.jsonc — example configuration (this file is NOT loaded automatically).
//
// A JSONC config file is the ONLY way to set ports, fieldbus, log level, and TLS — there are no
// CLI flags for these. Motion Master loads one of two config files, in this order:
//   1. --config <path>            — an explicit path always wins.
//   2. motion-master.jsonc        — auto-discovered next to the executable, if present.
// With neither, all built-in defaults apply (there is no system-wide /etc search path). To use
// this example, copy it to "motion-master.jsonc" beside the binary, or pass it via --config.
// (The Windows release already ships a motion-master.jsonc that raises the RT period to 4 ms.)
//
// Every key below shows its built-in default — delete the ones you don't override.
// This file is JSONC: // line comments and /* block comments */ are allowed.
{
  // HTTP API and WebSocket servers (each on its own port / loop / thread).
  "server": {
    // Address both listeners bind to.
    //   "127.0.0.1" (default) — reachable only from this machine, over the bundled
    //                           local.motion-master.synapticon.com name (an A record for 127.0.0.1).
    //   "0.0.0.0"             — reachable from the network. Browsers on other machines then use
    //                           https://<dashed-ip>.ip.motion-master.synapticon.com:61447, e.g.
    //                           192-168-1-50.ip.… for 192.168.1.50. The SAME bundled certificate
    //                           covers those names (it carries a *.ip.motion-master.synapticon.com
    //                           wildcard), so there is no certificate to install — but they are not
    //                           in public DNS, so each client machine needs one hosts-file line
    //                           mapping the name to the address. The console's Connection page
    //                           shows the exact line to add. See docs/LAN_DEPLOYMENT.md.
    //
    // WARNING: Motion Master has no authentication. Anything that can reach these ports can enable
    // drives and command motion. Bind off loopback only on a network you trust.
    "bindAddress": "127.0.0.1",
    "httpPort": 61447,
    "wsPort": 62281,
    "corsOrigin": "https://motion-master.synapticon.com"
  },

  // Fieldbus driver to initialise at startup.
  // Omit this whole block (or leave "driver" empty) to NOT auto-init — the fieldbus then
  // waits to be initialised from the client via POST /api/init.
  "fieldbus": {
    "driver": "soem",   // soem | spoe  (spoe planned; only soem is implemented today)
    "adapter": "eth0",  // soem: NIC MAC (AA:BB:CC:DD:EE:FF or AA-BB-CC-DD-EE-FF) or interface name
    // spoe will instead take a list of device addresses: "ipAddresses": ["192.168.0.10"]

    // SOEM only. Keep SOEM 2.0's mailbox-status FMMU active — the extra input FMMU it maps the SM1
    // mailbox-status register (0x080D) into the cyclic image on every mailbox slave. Motion Master
    // does not use it, and on TI PRU-ICSS ESCs a register-space FMMU inside an LRW is fatal (every
    // cyclic frame is dropped and SAFE-OP → OP fails). Default false deactivates it after mapping;
    // set true only for hardware that both needs and supports it.
    "mailboxStatusFmmu": false
  },

  // Log verbosity: trace | debug | info | warning | error | critical | off
  "logLevel": "info",

  // Real-time cyclic loop.
  "gameLoop": {
    "periodUs": 1000  // cyclic timer period in microseconds (1000 = 1 ms); must be > 0
  },

  // Lossless process-data recorder (the flight-data ring every RT cycle is appended to).
  "recorder": {
    // Depth of the ring in cycles/rows; sized at process-image configuration to hold exactly this
    // many cycles, independent of the gameLoop period (records carry absolute timestamps). RAM ≈
    // capacity × per-cycle record bytes: 28 B fixed (20-byte header + 8-byte publication word) plus
    // the whole-bus IOmap (~82 B per SOMANET drive, budget ~100 B). A single drive at 300000 cycles
    // × ~128 B ≈ 38 MB (≈ 5 min at a 1 ms period); it scales with drive count.
    "capacity": 300000,
    // Directory for .mmpd dumps written by POST /api/process-data/dump.
    // Empty = a "motion-master" subdirectory of the OS temp directory (created on first dump).
    "dumpDir": ""
  },

  // On-disk cache of CoE parameter definitions.
  //
  // Enumerating a drive's object dictionary over SDO is hundreds of mailbox round-trips and takes
  // seconds. The result — the parameter DEFINITIONS (index, name, data type, access, units, and the
  // default/min/max bounds), NOT the live values — is identical for every device of the same vendor,
  // product, and revision. Motion Master caches it to a human-readable JSON file per identity (under
  // a per-user cache directory) and reuses it on a later scan of the same hardware, so re-reading the
  // device list after a scan no longer re-enumerates devices it has seen before.
  //
  // Live values are NEVER cached: on a cache hit each value is still read from the device, so a stale
  // cache can at most cost a re-enumeration, never show a stale value as if current.
  "parameterCache": {
    "enabled": true,         // master switch; false disables the cache entirely

    // Which vendors to cache. The cache is keyed only on (vendor, product, revision), so it is only
    // correct for a vendor that bumps its revision whenever the object dictionary changes.
    //   false (default): cache ONLY Synapticon devices (vendor 0x22D2), for which this holds.
    //   true:            cache EVERY vendor — enable only if you trust your other vendors' revision
    //                    discipline; otherwise a firmware change that reuses a revision could serve
    //                    mismatched definitions.
    "cacheAllVendors": false,

    // Directory for the cache files. Empty = a standard per-user cache directory
    // ($XDG_CACHE_HOME or ~/.cache on Linux, %LOCALAPPDATA% on Windows, ~/Library/Caches on macOS),
    // under "motion-master/parameters". Set an absolute path to override.
    "directory": ""
  },

  // CoE object-dictionary behaviour.
  "parameters": {
    // Read a device's object dictionary the first time it reaches PRE-OP (the earliest AL state
    // with a live CoE mailbox), so object names and data types are known for recorder dumps,
    // monitoring, and the Parameters page without a manual read. Cache-backed (see parameterCache),
    // so a given device model pays the (one-time) enumeration once. The first such transition for a
    // never-seen model takes a few extra seconds; set false to keep transitions minimal and load
    // definitions lazily when a device's Parameters are opened.
    "readObjectDictionaryOnPreop": true,

    // When reading parameter *values*, read each multi-subindex object (ARRAY/RECORD) with a single
    // CoE Complete Access upload instead of one upload per subindex, cutting mailbox round-trips.
    // Support is probed once per device; a slave that rejects it transparently falls back to
    // per-subindex reads, so this is safe to leave on. Set false only for firmware with a broken
    // Complete Access implementation.
    "useCompleteAccess": true
  },

  // TLS certificate for the HTTPS API and secure WebSocket.
  "tls": {
    // "" (default) = auto-discover: cert.pem/key.pem next to the binary (release install), then a
    // local acme.sh install, then the install-dir default (which startup self-heal can populate).
    // Set explicit paths to pin them and skip discovery; a relative path is resolved against the
    // process working directory, not the binary's directory.
    "certPath": "",
    "keyPath": "",
    // Auto-fetch a fresh certificate at startup when the current one is missing, expired, or
    // expiring soon (within 7 days). Set false for air-gapped installs.
    "autoUpdate": true
  }
}
