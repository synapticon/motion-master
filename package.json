{
  "name": "motion-master-workspace",
  "private": true,
  "version": "6.0.0-alpha.128",
  "scripts": {
    "dev": "pnpm --filter console dev",
    "build": "pnpm --filter @synapticon/motion-master-client generate && pnpm --filter console build",
    "generate-api": "pnpm --filter @synapticon/motion-master-client generate",
    "build:client": "pnpm --filter @synapticon/motion-master-client generate && pnpm --filter @synapticon/motion-master-client build",
    "format": "prettier --write --no-error-on-unmatched-pattern \"web/**/*.{ts,tsx,js,mjs,cjs}\" \"tools/**/*.{js,mjs}\" eslint.config.mjs vitest.config.ts",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"web/**/*.{ts,tsx,js,mjs,cjs}\" \"tools/**/*.{js,mjs}\" eslint.config.mjs vitest.config.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "msw": "3.0.3",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.3",
    "vitest": "5.0.5"
  }
}
