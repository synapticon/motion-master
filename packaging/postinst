#!/bin/bash
set -e
setcap cap_sys_nice,cap_net_admin,cap_net_raw,cap_ipc_lock=eip /opt/motion-master/motion-master

# Download auto-tuning. The package does not carry that file, and install-auto-tuning.sh explains
# why. The script exits with status 0 even when the download fails, so an install on a machine
# with no network still succeeds and leaves a working server. The rpm %post scriptlet in
# tools/package.sh runs the same script. Keep the two in step.
/opt/motion-master/install-auto-tuning.sh /opt/motion-master
