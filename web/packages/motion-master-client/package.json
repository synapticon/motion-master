{
  "name": "@synapticon/motion-master-client",
  "version": "6.0.0-alpha.123",
  "description": "Isomorphic TypeScript client for Motion Master: the generated HTTP API client, the WebSocket connection, and helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapticon/motion-master.git",
    "directory": "web/packages/motion-master-client"
  },
  "homepage": "https://github.com/synapticon/motion-master/tree/main/web/packages/motion-master-client#readme",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "swagger-typescript-api generate -p ../../../apps/motion_master/swagger.yml -o ./src/generated -n api.ts --modular",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "prepublishOnly": "pnpm run generate && pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "swagger-typescript-api": "^13.7.2",
    "typescript": "^5.6.0"
  }
}
