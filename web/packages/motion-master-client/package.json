{
  "name": "@synapticon/motion-master-client",
  "version": "6.0.0-alpha.126",
  "description": "Isomorphic TypeScript client for Motion Master: the generated HTTP API client, the WebSocket connection, and helpers.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synapticon/motion-master.git",
    "directory": "web/packages/motion-master-client"
  },
  "homepage": "https://github.com/synapticon/motion-master/tree/main/web/packages/motion-master-client#readme",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "swagger-typescript-api generate -p ../../../apps/motion_master/swagger.yml -o ./src/generated -n api.ts --modular -t ./templates --custom-config ./templates/config.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "example": "tsx --tsconfig examples/tsconfig.json",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "prepublishOnly": "pnpm run generate && pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "@types/debug": "4.1.13",
    "@types/node": "^22.20.5",
    "commander": "15.0.0",
    "swagger-typescript-api": "13.12.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "debug": "4.4.3",
    "jsonc-parser": "3.3.1"
  }
}
